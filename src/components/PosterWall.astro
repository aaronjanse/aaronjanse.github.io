---
import { Image } from 'astro:assets';
import rust from '../assets/posters/rust-no-reflection.png';
import curve from '../assets/posters/curve25519.png';
import laszewo from '../assets/posters/laszewo-matched-frame-v2.png';

const posters = [
  { image: rust, name: 'rust', alt: 'Framed Rewrite It in Rust poster featuring Ferris holding a red Rust flag' },
  { image: curve, name: 'curve', alt: 'Framed Curve25519 mathematical poster illustrating elliptic curve addition' },
  { image: laszewo, name: 'laszewo', alt: 'Signed Łaszewo Meet Us in the Middle tour poster in a black frame' },
];
---

<div class="poster-wall" role="group" aria-label="Posters on my wall">
  {posters.map(({ image, name, alt }) => (
    <div class:list={['poster', name]}>
      <Image src={image} alt={alt} width={1000} format="webp" quality={85} loading="eager" />
    </div>
  ))}
</div>

<style>
  .poster-wall {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: start;
    gap: clamp(24px, 6vw, 60px);
    margin: 0 0 3.5rem;
  }

  .poster {
    position: relative;
    aspect-ratio: 0.8;
    overflow: hidden;
    background: #222;
    box-shadow: 2px 4px 6px rgb(0 0 0 / 25%),
                4px 9px 14px rgb(0 0 0 / 28%);
    transform-origin: 50% 8%;
  }

  /* Each photo is cropped (and the Rust one perspective-corrected) to the
     outside edges of its frame, so the frames share the box's proportions. */
  .poster img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: none;
  }

  .rust { transform: rotate(-2deg); }
  .curve { transform: rotate(1.2deg); }
  .laszewo { transform: rotate(-1.3deg); }

  @media (max-width: 480px) {
    .poster-wall { margin-bottom: 2.5rem; }
  }
</style>
